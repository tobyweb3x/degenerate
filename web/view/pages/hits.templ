package frontend

import (
	"fmt"
	"golang.org/x/text/cases"
	"golang.org/x/text/language"
	"strings"
	"web/protos"
)

templ SimilarityHitsPage(param []TemplateModel[protos.ClientEbo_CrossPlatformHit]) {
	@document(SimilarityHitsPartial(param), nil)
}

templ SimilarityHitsPartial(param []TemplateModel[protos.ClientEbo_CrossPlatformHit]) {
	<div id="content" class="h-full">
		<div class="mx-3 h-full flex flex-col">
			<div class="flex gap-3 py-4 justify-center items-center w-fit">
				<p class="text-2xl font-archivoSemiBold text-left">Similarity Hits</p>
				<!-- This span will be updated by Javascript -->
				<p id="total-visible-count" class="text-sm font-archivo rounded-full bg-[#FFFFFF4D] px-1.5 py-0.5 text-center w-fit h-fit">
					{ fmt.Sprintf("%d", len(param)) }
				</p>
			</div>
			if len(param) > 0 {
				<form id="bulk-delete-form" hx-post="/delete/hits" hx-target="#content" hx-swap="outerHTML" class="flex flex-col h-full min-h-0">
					<div class="flex justify-between items-center mb-3 shrink-0">
						<!-- UNIFIED FILTERS -->
						<div class="flex gap-4">
							<!-- Platform Filters -->
							<div class="flex gap-2 items-center border-r border-white/20 pr-4">
								<span class="text-xs text-gray-400 font-archivo">Platform:</span>
								<button type="button" onclick="applyFilters('platform', 'ALL', this)" class="filter-btn platform-btn active-filter px-3 py-1 rounded-full text-xs cursor-pointer transition bg-emerald-500/20 ring-1 ring-emerald-400 shadow-[0_0_8px_rgba(16,185,129,0.6)]">
									All
								</button>
								<button type="button" onclick="applyFilters('platform', 'POLYMARKET', this)" class="filter-btn platform-btn flex items-center gap-2 px-3 py-1 bg-white/20 hover:bg-white/30 rounded-full text-xs cursor-pointer transition">
									<span>Polymarket</span>
									<span class="poly-count text-xs font-dmSans rounded-full bg-black px-1.5 py-0.5">0</span>
								</button>
								<button type="button" onclick="applyFilters('platform', 'KALSHI', this)" class="filter-btn platform-btn flex items-center gap-2 px-3 py-1 bg-white/20 hover:bg-white/30 rounded-full text-xs cursor-pointer transition">
									<span>Kalshi</span>
									<span class="kalshi-count text-xs font-dmSans rounded-full bg-black px-1.5 py-0.5">0</span>
								</button>
							</div>
							<!-- Category Filters -->
							<div class="flex gap-2 items-center">
								<span class="text-xs text-gray-400 font-archivo">Category:</span>
								<button type="button" onclick="applyFilters('category', 'ALL', this)" class="filter-btn category-btn active-filter px-3 py-1 rounded-full text-xs cursor-pointer transition bg-emerald-500/20 ring-1 ring-emerald-400 shadow-[0_0_8px_rgba(16,185,129,0.6)]">
									All
								</button>
								<button type="button" onclick="applyFilters('category', 'sport', this)" class="filter-btn category-btn flex items-center gap-2 px-3 py-1 bg-white/20 hover:bg-white/30 rounded-full text-xs cursor-pointer transition">
									<span>Sport</span>
									<span class="sport-count text-xs font-dmSans rounded-full bg-black px-1.5 py-0.5">0</span>
								</button>
								<button type="button" onclick="applyFilters('category', 'politics', this)" class="filter-btn category-btn flex items-center gap-2 px-3 py-1 bg-white/20 hover:bg-white/30 rounded-full text-xs cursor-pointer transition">
									<span>Politics</span>
									<span class="politics-count text-xs font-dmSans rounded-full bg-black px-1.5 py-0.5">0</span>
								</button>
							</div>
						</div>
						<div class="flex gap-2 items-center">
							<!-- Multi-Delete Buttons ... (Kept exactly as you had them) -->
							<button type="button" id="start-multi-btn" onclick="toggleMultiDelete(true)" class="w-fit cursor-pointer bg-purple-800 hover:bg-purple-500 font-dmSans py-2 px-3 rounded-xl text-xs transition-colors">
								Delete Multiples
							</button>
							<button type="button" id="cancel-multi-btn" onclick="toggleMultiDelete(false)" class="hidden w-fit cursor-pointer bg-gray-600 hover:bg-gray-500 font-dmSans py-2 px-3 rounded-xl text-xs transition-colors">
								Cancel
							</button>
							<button type="submit" id="confirm-multi-btn" hx-confirm="Delete selected hits?" class="hidden w-fit bg-red-600 hover:bg-red-500 font-dmSans py-2 px-3 rounded-xl text-xs transition-colors opacity-50 cursor-not-allowed" disabled>
								Delete Selected (0)
							</button>
						</div>
					</div>
					<section class="ml-2.5 overflow-y-auto flex-1 min-h-0 pb-4">
						<ul id="needsResolve" class="space-y-3">
							for i, hit := range param {
								if hit.Payload.CrossPlatformHit == nil {
									continue
								}
								<!-- NOTE: Added data-category here -->
								<li
									class="relative border-4 border-white/30 rounded-2xl px-2.5 py-2.5 text-md transition-colors duration-150 hover:bg-white/5 cursor-pointer listings"
									data-platform={ hit.Payload.CrossPlatformHit.Anchor.Platform.String() }
									data-category={ strings.ToLower(hit.Payload.CrossPlatformHit.Anchor.MarketCategory) }
								>
									<!-- Checkbox ... -->
									<div class="absolute top-4 right-16 z-10 hidden multi-select-wrapper pointer-events-none">
										<input type="checkbox" name="ids" value={ hit.CorrelationId } class="multi-select w-5 h-5 rounded-md accent-red-500 cursor-pointer"/>
									</div>
									<a class="nav-link block" hx-get={ templ.SafeURL(fmt.Sprintf("/resolve/hit/%s", hit.CorrelationId)) } hx-trigger="click" hx-target="#content" hx-swap="innerHTML" hx-push-url="true">
										<!-- ... Inner content exactly as you had it ... -->
										<div class="flex justify-between w-full">
											<p><span class="font-archivo text-sm">Question:</span> { hit.Payload.CrossPlatformHit.Anchor.Question }</p>
											<p class="font-extrabold text-xs numbering">{ fmt.Sprintf("%d", i+1) }</p>
										</div>
										<p><span class="font-archivo text-sm">Outcomes: </span> { hit.Payload.CrossPlatformHit.Anchor.Outcome }</p>
										<div class="flex gap-8 mt-2.5">
											<p class="text-xs font-archivo">foundAt: <span class=" text-sm font-archivoSemiBold">{ friendlyTime(hit.ArbFoundAt) } </span></p>
											<p class="text-xs font-archivo">platform: <span class=" text-sm font-archivoSemiBold">{ cases.Title(language.English).String(hit.Payload.CrossPlatformHit.Anchor.Platform.String()) }</span></p>
											<p class="text-xs font-archivo">anchor expiration: <span class=" text-sm font-archivoSemiBold">{ friendlyTimeFromString(hit.Payload.CrossPlatformHit.Anchor.CloseTimeMs) }</span></p>
											<p class="text-xs font-archivo">category: <span class=" text-sm font-archivoSemiBold">{ cases.Title(language.English).String(hit.Payload.CrossPlatformHit.Anchor.MarketCategory) }</span></p>
										</div>
										<section class="flex justify-between items-center">
											<ul class="flex gap-4 pt-2.5 items-baseline">
												Matches: 
												for i, j := range hit.Payload.CrossPlatformHit.Matches {
													<li class="text-xs"><span class="rounded-full bg-[#FFFFFF4D] px-2">{ fmt.Sprintf("%d", i+1) }</span> { fmt.Sprintf("%.2f%%", j.Scored * 100) }</li>
												}
											</ul>
											<button type="button" hx-post={ templ.SafeURL(fmt.Sprintf("/delete/hit/%s", hit.CorrelationId)) } hx-target="#content" hx-swap="outerHTML" hx-confirm="Are you sure?" hx-trigger="click consume" hx-push-url="false" hx-on:click="event.stopPropagation()" class="single-delete-btn w-fit transition-all duration-150 hover:bg-red-500/20 hover:ring-1 hover:ring-red-400 rounded-full cursor-pointer relative z-20">
												<img src="/assets/svg/delete-red.svg" alt="" class="w-6 aspect-square"/>
											</button>
										</section>
									</a>
								</li>
							}
						</ul>
					</section>
				</form>
			} else {
				<p class="h-full w-full mx-auto my-auto text-2xl font-dmSans text-center items-center grid place-items-center">No hits needs resolving</p>
			}
		</div>
		@hitsFilterAndMultiDeleteScripts()
	</div>
}

templ ResolveHitPage(param TemplateModel[protos.ClientEbo_CrossPlatformHit]) {
	@document(ResolveHitPartial(param), nil)
}

templ ResolveHitPartial(param TemplateModel[protos.ClientEbo_CrossPlatformHit]) {
	<div id="resolve" class="grid grid-cols-[1fr_auto] h-full gap-2.5">
		<section id="listings" class="h-full flex flex-col overflow-hidden">
			<div class="shrink-0">
				@backBtn("hits")
				<p class="mt-6 font-dmSans font-extralight text-sm">Resolve for: <span class="font-bold font-archivoSemiBold text-base">{ shortenID(param.CorrelationId) }</span></p>
				<div class="mt-2">
					<div class="flex w-full justify-between item">
						<p class="font-archivoSemiBold font-extralight text-xl">Anchor:</p>
						<button
							type="button"
							hx-post={ templ.SafeURL(fmt.Sprintf("/delete/hit/%s", param.CorrelationId)) }
							hx-target="#resolve"
							hx-swap="outerHTML"
							hx-confirm="Are you sure you want to delete this hit?"
							hx-trigger="click"
							hx-push-url="/hits"
							class="w-fit 
								transition-all duration-150
								hover:bg-red-500/20
								hover:ring-1 hover:ring-red-400
								rounded-full
								cursor-pointer"
						>
							<img src="/assets/svg/delete-red.svg" alt="" class="w-6 aspect-square"/>
						</button>
					</div>
					{{ anchor := param.Payload.CrossPlatformHit.Anchor }}
					{{ anchorOutcomes := ParseOutcomes(anchor.Outcome) }}
					<div class="border-2 border-[#FFFFFF4D] rounded-2xl p-2.5 mt-2.5 text-md">
						<p><span class="font-archivo text-sm">Question:</span> { anchor.Question }</p>
						<p><span class="font-archivo text-sm">Outcomes: </span> { anchor.Outcome }</p>
						<div class="flex gap-8 mt-2.5">
							<p class="text-xs font-dmSans">EndDate: <span class=" text-sm font-archivoSemiBold">{ friendlyTimeFromString(anchor.CloseTimeMs ) } </span></p>
							<p class="text-xs font-archivo">platform: <span class=" text-sm font-archivoSemiBold">{ cases.Title(language.English).String(anchor.Platform.String() ) }</span></p>
							<p class="text-xs font-archivo">market: <span class="text-sm font-archivoSemiBold">{ fmt.Sprintf("%s/%s", cases.Title(language.English).String(anchor.MarketCategory), anchor.MarketSubcategory) }</span></p>
						</div>
						<p class="font-extrabold font-archivoSemiBold text-sm mt-3">Rules:</p>
						<p class="font-dmSans text-sm">{ anchor.Rules }</p>
					</div>
				</div>
			</div>
			<div class="mt-4 flex-1 min-h-0 flex flex-col">
				<p class="font-archivo font-extralight text-lg">Matches <span>({ len( param.Payload.CrossPlatformHit.Matches) })</span>:</p>
				<div class="overflow-y-auto h-full">
					<ul class="space-y-2.5 mt-2.5 pb-5">
						for i, match := range param.Payload.CrossPlatformHit.Matches {
							{{ matchOutcomes := ParseOutcomes(match.MarketInfo.Outcome) }}
							<li class="border-2 border-[#FFFFFF4D] rounded-2xl px-2.5 py-2.5 text-md transition-all duration-300" id={ fmt.Sprintf("match-row-%s", match.MarketInfo.Uuid) }>
								<div class="flex flex-row justify-between">
									<div>
										<p class="text-sm font-dmSans font-bold"><span class="font-archivo text-sm">Question:</span> { match.MarketInfo.Question }</p>
										<p class="text-sm font-dmSans font-bold"><span class="font-archivo text-sm">Outcomes: </span> { match.MarketInfo.Outcome }</p>
										<p><span class="font-archivo text-sm">Match: </span> { fmt.Sprintf("%.2f%%", match.Scored * 100) }</p>
										<div class="flex gap-8 mt-2.5">
											<p class="text-xs font-dmSans">EndDate: <span class="text-sm font-archivoSemiBold">{ friendlyTimeFromString(match.MarketInfo.CloseTimeMs) } </span></p>
											<p class="text-xs font-archivo">platform: <span class="text-sm font-archivoSemiBold">{ cases.Title(language.English).String(match.MarketInfo.Platform.String()) }</span></p>
											<p class="text-xs font-archivo">market: <span class="text-sm font-archivoSemiBold">{ fmt.Sprintf("%s/%s", cases.Title(language.English).String(match.MarketInfo.MarketCategory), match.MarketInfo.MarketSubcategory) }</span></p>
										</div>
									</div>
									<section class="pr-2 flex flex-col items-end gap-2">
										<p class="font-extrabold text-xs text-right">#{ fmt.Sprintf("%d", i+1) }</p>
										<div class="pr-7 flex flex-col h-fit items-center gap-3.5">
											<select
												id={ fmt.Sprintf("select-%s", match.MarketInfo.Uuid) }
												class="bg-black border border-gray-600 rounded p-1 text-xs mt-2 outline-green-600 cursor-pointer"
												_="on change 
													if my value is not empty 
														remove @disabled from next <button/> 
														remove .opacity-50 from next <button/>
														remove .cursor-not-allowed from next <button/>
														add .cursor-pointer to next <button/>
													else 
														add @disabled to next <button/> 
														add .opacity-50 to next <button/>
														add .cursor-not-allowed to next <button/>
														remove .cursor-pointer from next <button/>
													end"
											>
												<option value="">select leg</option>
												<optgroup label={ fmt.Sprintf("Anchor: %s", GetOutcomeByIndex(anchorOutcomes, 0)) }>
													<option
														value={ fmt.Sprintf("%s|0|0", match.MarketInfo.Uuid) }
														data-anum={ fmt.Sprintf("%d", i+1) }
														data-aname={ GetOutcomeByIndex(anchorOutcomes, 0) }
														data-mname={ GetOutcomeByIndex(matchOutcomes, 0) }
													>
														Match Leg 0
													</option>
													<option
														value={ fmt.Sprintf("%s|0|1", match.MarketInfo.Uuid) }
														data-anum={ fmt.Sprintf("%d", i+1) }
														data-aname={ GetOutcomeByIndex(anchorOutcomes, 0) }
														data-mname={ GetOutcomeByIndex(matchOutcomes, 1) }
													>
														Match Leg 1
													</option>
												</optgroup>
												<!-- ANCHOR LEG 1 -->
												<optgroup label={ fmt.Sprintf("Anchor: %s", GetOutcomeByIndex(anchorOutcomes, 1)) }>
													<option
														value={ fmt.Sprintf("%s|1|0", match.MarketInfo.Uuid) }
														data-anum={ fmt.Sprintf("%d", i+1) }
														data-aname={ GetOutcomeByIndex(anchorOutcomes, 1) }
														data-mname={ GetOutcomeByIndex(matchOutcomes, 0) }
													>
														Match Leg 0
													</option>
													<option
														value={ fmt.Sprintf("%s|1|1", match.MarketInfo.Uuid) }
														data-anum={ fmt.Sprintf("%d", i+1) }
														data-aname={ GetOutcomeByIndex(anchorOutcomes, 1) }
														data-mname={ GetOutcomeByIndex(matchOutcomes, 1) }
													>
														Match Leg 1
													</option>
												</optgroup>
											</select>
											<button
												type="button"
												disabled
												class="bg-purple-800 hover:bg-purple-500 text-white text-xs px-3 py-1 rounded transition-colors add-btn opacity-50 cursor-not-allowed"
												data-uuid={ match.MarketInfo.Uuid }
												data-question={ match.MarketInfo.Question }
												onclick="addToPick(this)"
											>
												Add to Picks
											</button>
											<span class="text-green-400 text-xs font-bold hidden added-label">
												✓ Added
											</span>
										</div>
									</section>
								</div>
								<p class="font-extrabold font-archivoSemiBold text-sm mt-3">Rules:</p>
								<p class="font-dmSans text-sm">{ match.MarketInfo.Rules }</p>
							</li>
						}
					</ul>
				</div>
			</div>
		</section>
		<section id="picks" class="w-80 h-full min-h-0 border-l border-[#FFFFFF20] bg-[#06001B] flex flex-col">
			<form hx-post={ templ.SafeURL(fmt.Sprintf("/resolve/hit/submit/%s", param.CorrelationId)) } hx-target="#mainContent" hx-push-url="true" class="flex flex-col h-full min-h-0">
				<div class="p-4 border-b border-[#FFFFFF20] shrink-0">
					<p class="text-xl font-archivoSemiBold">Selected Picks</p>
				</div>
				<div id="picks-container" class="flex-1 min-h-0 overflow-y-auto p-4 space-y-3">
					<p id="empty-msg" class="text-sm text-gray-500 text-center mt-10">
						No picks yet.
					</p>
				</div>
				<div class="p-4 border-t border-[#FFFFFF20] shrink-0">
					<button type="submit" class="w-full cursor-pointer bg-purple-800 hover:bg-purple-500 text-white font-bold py-3 px-4 rounded-xl">
						Submit Legs
					</button>
				</div>
			</form>
		</section>
		<template id="pick-item-template">
			<div class="pick-item bg-[#FFFFFF10] rounded-lg p-3 relative group animate-in fade-in zoom-in-95 duration-200 border border-[#FFFFFF20]">
				<input type="hidden" name="selections[]" class="pick-input"/>
				<div class="flex justify-between items-center mb-2 pb-2 border-b border-[#FFFFFF10]">
					<span class="text-sm font-bold text-white pick-title">Match #?</span>
					<button type="button" class="text-gray-400 hover:text-red-400 pick-remove-btn transition-colors cursor-pointer">✕</button>
				</div>
				<div class="bg-black/30 rounded p-2.5 flex flex-col gap-3">
					<div>
						<p class="text-gray-500 text-[10px] font-bold uppercase tracking-wider mb-1">Anchor</p>
						<p class="font-mono text-amber-300 text-xs font-medium warap-break-words leading-tight pick-anchor-leg">?</p>
					</div>
					<div>
						<p class="text-gray-500 text-[10px] font-bold uppercase tracking-wider mb-1">Match</p>
						<p class="font-mono text-purple-300 text-xs font-medium warap-break-words leading-tight pick-match-leg">?</p>
					</div>
				</div>
			</div>
		</template>
		<script>
			function addToPick(btn) {
				const uuid = btn.getAttribute("data-uuid");
				const selectEl = document.getElementById("select-" + uuid);

				// 1. Get Selected Option Data
				const selectedOption = selectEl.options[selectEl.selectedIndex];

				// Value sent to backend: "uuid|0|0"
				const value = selectEl.value;

				// Display Data for Sidebar:
				const anchorName = selectedOption.dataset.aname;
				const matchName = selectedOption.dataset.mname;
				const matchNum = selectedOption.dataset.anum;

				// --- DOM Operations ---
				const template = document.getElementById("pick-item-template");
				const clone = template.content.cloneNode(true);
				const rootDiv = clone.querySelector(".pick-item");

				rootDiv.id = "pick-item-" + uuid;

				// Set the CLEAN value for form submission
				clone.querySelector(".pick-input").value = value;

				// Use the data attributes for the UI
				clone.querySelector(".pick-title").textContent = "Match #" + matchNum;
				clone.querySelector(".pick-anchor-leg").textContent = anchorName;
				clone.querySelector(".pick-match-leg").textContent = matchName;

				// Bind Remove
				clone.querySelector(".pick-remove-btn").onclick = function () {
					removeFromPick(uuid);
				};

				// Append
				const container = document.getElementById("picks-container");
				document.getElementById("empty-msg").classList.add("hidden");
				container.appendChild(clone);

				// Toggle UI
				const row = document.getElementById("match-row-" + uuid);
				row.classList.add("border-green-500", "bg-[#FFFFFF05]");
				btn.classList.add("hidden");
				row.querySelector(".added-label").classList.remove("hidden");
				selectEl.disabled = true;
			}

			// Remove function stays the same...
			function removeFromPick(uuid) {
				const item = document.getElementById("pick-item-" + uuid);
				if (item) item.remove();

				const container = document.getElementById("picks-container");
				if (container.children.length <= 1) {
					document.getElementById("empty-msg").classList.remove("hidden");
				}

				const row = document.getElementById("match-row-" + uuid);
				if (row) {
					row.classList.remove("border-green-500", "bg-[#FFFFFF05]");

					// 2. Reset Button State (The fix)
					const btn = row.querySelector(".add-btn");
					btn.classList.remove("hidden"); // Show button
					btn.classList.remove("cursor-pointer"); // Remove pointer cursor
					btn.classList.add("opacity-50", "cursor-not-allowed"); // Add dull styles
					btn.disabled = true; // Disable interaction

					// 3. Hide "Added" Label
					row.querySelector(".added-label").classList.add("hidden");

					// 4. Reset Select
					const select = document.getElementById("select-" + uuid);
					select.disabled = false;
					select.value = "";
				}
			}
		</script>
	</div>
}

templ hitsFilterAndMultiDeleteScripts() {
	<script>
			let multiMode = false;

			function toggleMultiDelete(enable) {
				multiMode = enable;

				const startBtn = document.getElementById("start-multi-btn");
				const cancelBtn = document.getElementById("cancel-multi-btn");
				const confirmBtn = document.getElementById("confirm-multi-btn");

				const checkboxes = document.querySelectorAll(".multi-select-wrapper");
				const rawInputs = document.querySelectorAll(".multi-select");
				const numberings = document.querySelectorAll(".numbering");
				const singleDeletes = document.querySelectorAll(".single-delete-btn");

				if (multiMode) {
					// Enter Delete Mode
					startBtn.classList.add("hidden");
					cancelBtn.classList.remove("hidden");
					confirmBtn.classList.remove("hidden");

					checkboxes.forEach((cb) => cb.classList.remove("hidden"));
					numberings.forEach((n) => n.classList.add("hidden"));
					singleDeletes.forEach((btn) => btn.classList.add("hidden"));
				} else {
					// Exit Delete Mode
					startBtn.classList.remove("hidden");
					cancelBtn.classList.add("hidden");
					confirmBtn.classList.add("hidden");

					checkboxes.forEach((cb) => cb.classList.add("hidden"));
					numberings.forEach((n) => n.classList.remove("hidden"));
					singleDeletes.forEach((btn) => btn.classList.remove("hidden"));

					// Reset selections and UI back to default (unselected)
					rawInputs.forEach((input) => {
						input.checked = false;
						const li = input.closest("li");
						// Remove selected styles
						li.classList.remove("border-red-500", "bg-red-900/20", "border-2");
						// Restore default styles
						li.classList.add("border-white/30", "border-4");
					});
					updateSelectedCount();
				}
			}

			function updateSelectedCount() {
				const count = document.querySelectorAll(".multi-select:checked").length;
				const confirmBtn = document.getElementById("confirm-multi-btn");

				if (confirmBtn) {
					confirmBtn.textContent = `Delete Selected (${count})`;
					if (count > 0) {
						confirmBtn.disabled = false;
						confirmBtn.classList.add("cursor-pointer");
						confirmBtn.classList.remove("opacity-50", "cursor-not-allowed");
					} else {
						confirmBtn.disabled = true;
						confirmBtn.classList.add("opacity-50", "cursor-not-allowed");
						confirmBtn.classList.remove("cursor-pointer");
					}
				}
			}

			// Intercept Clicks
			document.addEventListener(
				"click",
				(e) => {
					if (!multiMode) return;

					const li = e.target.closest(".listings");
					if (!li) return;

					// Prevent HTMX navigation!
					e.preventDefault();
					e.stopPropagation();

					// If the user actually clicked the checkbox itself, the browser
					// already toggled 'checked'. We don't want to double-toggle it.
					const checkbox = li.querySelector(".multi-select");
					if (!checkbox) return;

					if (e.target !== checkbox) {
						checkbox.checked = !checkbox.checked;
					}

					// Toggle Visuals (Including Border Width)
					if (checkbox.checked) {
						// Remove default styles
						li.classList.remove("border-white/30", "border-4");
						// Add selected styles (Thinner border)
						li.classList.add("border-red-500", "bg-red-900/20", "border-2");
					} else {
						// Remove selected styles
						li.classList.remove("border-red-500", "bg-red-900/20", "border-2");
						// Restore default styles
						li.classList.add("border-white/30", "border-4");
					}

					updateSelectedCount();
				},
				true,
			);

			// 1. Store the current filter state
			let currentFilters = {
				platform: "ALL",
				category: "ALL",
			};

			// 2. Initialize counts immediately when the script loads
			document.addEventListener("DOMContentLoaded", updateCounts);

			// Also run it immediately in case DOMContentLoaded already fired (due to HTMX swapping)
			updateCounts();

			function applyFilters(filterType, filterValue, btnEl) {
				const container = document.querySelector("#needsResolve");
				container.classList.add("loading");

				// Update state
				currentFilters[filterType] = filterValue;

				setTimeout(() => {
					// Update Button Styling for the active group
					const groupClass =
						filterType === "platform" ? ".platform-btn" : ".category-btn";
					document.querySelectorAll(groupClass).forEach((b) => {
						b.classList.remove(
							"bg-emerald-500/20",
							"ring-1",
							"ring-emerald-400",
							"shadow-[0_0_8px_rgba(16,185,129,0.6)]",
						);
						b.classList.add("bg-white/20");
					});

					btnEl.classList.remove("bg-white/20");
					btnEl.classList.add(
						"bg-emerald-500/20",
						"ring-1",
						"ring-emerald-400",
						"shadow-[0_0_8px_rgba(16,185,129,0.6)]",
					);

					// Apply the dual-filter logic to all items
					const items = document.querySelectorAll(".listings");
					let visibleCount = 0;

					items.forEach((item) => {
						const p = item.dataset.platform;
						const c = item.dataset.category;

						const platformMatch =
							currentFilters.platform === "ALL" ||
							p === currentFilters.platform;
						const categoryMatch =
							currentFilters.category === "ALL" ||
							c === currentFilters.category;

						if (platformMatch && categoryMatch) {
							item.classList.remove("hidden");
							visibleCount++;
						} else {
							item.classList.add("hidden");
						}
					});

					// Update the master total at the very top
					document.getElementById("total-visible-count").innerText =
						visibleCount;

					container.classList.remove("loading");
				}, 10);
			}

			// 3. Helper to count and update the black badges
			function updateCounts() {
				const items = document.querySelectorAll(".listings");

				let counts = {
					poly: 0,
					kalshi: 0,
					sport: 0,
					politics: 0,
				};

				items.forEach((item) => {
					const p = item.dataset.platform;
					const c = item.dataset.category;

					if (p === "POLYMARKET") counts.poly++;
					if (p === "KALSHI") counts.kalshi++;

					if (c === "sport") counts.sport++;
					if (c === "politics") counts.politics++;
				});

				// Update the DOM
				const elPoly = document.querySelector(".poly-count");
				const elKalshi = document.querySelector(".kalshi-count");
				const elSport = document.querySelector(".sport-count");
				const elPolitics = document.querySelector(".politics-count");

				if (elPoly) elPoly.innerText = counts.poly;
				if (elKalshi) elKalshi.innerText = counts.kalshi;
				if (elSport) elSport.innerText = counts.sport;
				if (elPolitics) elPolitics.innerText = counts.politics;
			}
		</script>
	<style>
			.loading {
				filter: blur(5px);
				pointer-events: none;
			}
		</style>
}
